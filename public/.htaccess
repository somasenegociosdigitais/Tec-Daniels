<IfModule mod_rewrite.c>
  RewriteEngine On

  # Sempre com www — os backlinks apontam para www e a autoridade
  # não pode ficar dividida entre as duas versões.
  RewriteCond %{HTTP_HOST} ^tecdaniels\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://www.tecdaniels.com.br/$1 [R=301,L]

  # /pagina/index.html na URL antiga vira /pagina/
  RewriteCond %{THE_REQUEST} \s/+(.*)index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Serve /pagina/ a partir de /pagina/index.html sem redirecionar
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]
</IfModule>

DirectoryIndex index.html
ErrorDocument 404 /404.html

# --- URLs do site anterior -----------------------------------------------
Redirect 301 /instalacao-de-aquecedor /instalacao-de-aquecedor-a-gas/
Redirect 301 /instalacao-de-aquecedor.html /instalacao-de-aquecedor-a-gas/
Redirect 301 /manutencao-de-aquecedor-a-gas.html /manutencao-de-aquecedor-a-gas/
Redirect 301 /quem-somos.html /quem-somos/
Redirect 301 /remanejamento-de-ponto-de-gas.html /remanejamento-de-ponto-de-gas/
Redirect 301 /substituicao-de-tubulacao-a-gas.html /substituicao-de-tubulacao-de-gas/
Redirect 301 /teste-de-estanqueidade.html /teste-de-estanqueidade/
Redirect 301 /teste-de-vazamento.html /teste-de-vazamento-de-gas/
Redirect 301 /aplicacao-de-resina-em-tubulacao.html /aplicacao-de-resina-em-tubulacao/
Redirect 301 /aquecedor-rinnai.html /assistencia-tecnica-rinnai/
Redirect 301 /aquecedor-lorenzetti.html /assistencia-tecnica-lorenzetti/
Redirect 301 /aquecedor-komeco.html /assistencia-tecnica-komeco/
Redirect 301 /conversao-de-fogao-e-cooktop.html /conversao-de-fogao/
Redirect 301 /conversao-de-forno-gpl-para-gn.html /conversao-de-fogao/
Redirect 301 /produtos.html /venda-de-aquecedor-a-gas/

# --- Cache e compressão --------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Nada de arquivo oculto exposto (.git, .env, .DS_Store).
# O .well-known fica de fora: é usado na validação do certificado SSL.
RedirectMatch 404 ^/\.(?!well-known)

# Hostinger (Apache). No Netlify/Cloudflare vale o public/_redirects.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Sempre com www — os backlinks apontam para www e a autoridade
  # não pode ficar dividida entre as duas versões.
  RewriteCond %{HTTP_HOST} ^tecdaniels\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://www.tecdaniels.com.br/$1 [R=301,L]

  # --- URLs do site anterior ---------------------------------------------
  # Regra de rewrite, não mod_alias: o Redirect do mod_alias casava por
  # prefixo e não pegava a forma sem ".html" que o Google indexou.
  # Há backlinks apontando para algumas delas; o 301 transfere a autoridade.
  RewriteRule ^instalacao-de-aquecedor(\.html)?/?$ /instalacao-de-aquecedor-a-gas/ [R=301,L]
  RewriteRule ^aquecedor-rinnai(\.html)?/?$ /assistencia-tecnica-rinnai/ [R=301,L]
  RewriteRule ^aquecedor-lorenzetti(\.html)?/?$ /assistencia-tecnica-lorenzetti/ [R=301,L]
  RewriteRule ^aquecedor-komeco(\.html)?/?$ /assistencia-tecnica-komeco/ [R=301,L]
  RewriteRule ^aquecedor-rheem(\.html)?/?$ /assistencia-tecnica-rheem/ [R=301,L]
  RewriteRule ^substituicao-de-tubulacao-a-gas(\.html)?/?$ /substituicao-de-tubulacao-de-gas/ [R=301,L]
  RewriteRule ^teste-de-vazamento(\.html)?/?$ /teste-de-vazamento-de-gas/ [R=301,L]
  RewriteRule ^conversao-de-fogao-e-cooktop(\.html)?/?$ /conversao-de-fogao/ [R=301,L]
  RewriteRule ^conversao-de-forno-gpl-para-gn(\.html)?/?$ /conversao-de-fogao/ [R=301,L]
  RewriteRule ^produtos(\.html)?/?$ /venda-de-aquecedor-a-gas/ [R=301,L]
  RewriteRule ^manutencao-de-pressurizador(\.html)?/?$ /pressurizador-de-agua/ [R=301,L]
  RewriteRule ^instalacao-de-pressurizador(\.html)?/?$ /pressurizador-de-agua/ [R=301,L]
  RewriteRule ^manutencao-de-boiler(\.html)?/?$ /conserto-de-aquecedor-a-gas/ [R=301,L]
  RewriteRule ^index/?$ / [R=301,L]

  # Qualquer URL antiga terminada em .html cujo slug virou pasta:
  # /quem-somos.html -> /quem-somos/
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+)\.html$ /$1/ [R=301,L]

  # /pagina/index.html na URL antiga vira /pagina/
  RewriteCond %{THE_REQUEST} \s/+(.*)index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Serve /pagina/ a partir de /pagina/index.html sem redirecionar
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]
</IfModule>

DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

# --- Cache e compressão ---------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Nada de arquivo oculto exposto (.git, .env, .DS_Store).
# O .well-known fica de fora: é usado na validação do certificado SSL.
RedirectMatch 404 ^/\.(?!well-known)

# --- Cache -----------------------------------------------------------------
# Arquivos do Astro têm hash no nome: mudam de nome quando mudam de conteúdo,
# então podem ficar um ano no cache do navegador. Sem isso as fontes vinham
# com 7 dias e recarregavam à toa (PageSpeed, 28/08/2026).
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpe?g|png|gif|svg|ico|avif)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

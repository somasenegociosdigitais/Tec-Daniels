---
/** Ícones lucide de verdade, inlinados no build a partir do lucide-static.
 *  Espelha components/core/Icon.jsx do design system (size=20, strokeWidth=1.75).
 *  Uso: <Icone nome="phone" tam={16} /> */
import alertTriangle from 'lucide-static/icons/triangle-alert.svg?raw';
import arrowRight from 'lucide-static/icons/arrow-right.svg?raw';
import arrowUpRight from 'lucide-static/icons/arrow-up-right.svg?raw';
import badgeCheck from 'lucide-static/icons/badge-check.svg?raw';
import building2 from 'lucide-static/icons/building-2.svg?raw';
import cable from 'lucide-static/icons/cable.svg?raw';
import calendar from 'lucide-static/icons/calendar.svg?raw';
import check from 'lucide-static/icons/check.svg?raw';
import chevronDown from 'lucide-static/icons/chevron-down.svg?raw';
import chevronRight from 'lucide-static/icons/chevron-right.svg?raw';
import clipboardCheck from 'lucide-static/icons/clipboard-check.svg?raw';
import clock from 'lucide-static/icons/clock.svg?raw';
import cookingPot from 'lucide-static/icons/cooking-pot.svg?raw';
import droplets from 'lucide-static/icons/droplets.svg?raw';
import facebook from 'lucide-static/icons/facebook.svg?raw';
import fileCheck from 'lucide-static/icons/file-check.svg?raw';
import flame from 'lucide-static/icons/flame.svg?raw';
import flameKindling from 'lucide-static/icons/flame-kindling.svg?raw';
import gauge from 'lucide-static/icons/gauge.svg?raw';
import home from 'lucide-static/icons/house.svg?raw';
import instagram from 'lucide-static/icons/instagram.svg?raw';
import mail from 'lucide-static/icons/mail.svg?raw';
import mapPin from 'lucide-static/icons/map-pin.svg?raw';
import messageCircle from 'lucide-static/icons/message-circle.svg?raw';
import move from 'lucide-static/icons/move.svg?raw';
import phone from 'lucide-static/icons/phone.svg?raw';
import pipette from 'lucide-static/icons/pipette.svg?raw';
import power from 'lucide-static/icons/power.svg?raw';
import receipt from 'lucide-static/icons/receipt.svg?raw';
import searchCheck from 'lucide-static/icons/search-check.svg?raw';
import shieldCheck from 'lucide-static/icons/shield-check.svg?raw';
import shoppingBag from 'lucide-static/icons/shopping-bag.svg?raw';
import star from 'lucide-static/icons/star.svg?raw';
import thermometer from 'lucide-static/icons/thermometer.svg?raw';
import thermometerSnowflake from 'lucide-static/icons/thermometer-snowflake.svg?raw';
import trendingUp from 'lucide-static/icons/trending-up.svg?raw';
import volume2 from 'lucide-static/icons/volume-2.svg?raw';
import volumeX from 'lucide-static/icons/volume-x.svg?raw';
import waves from 'lucide-static/icons/waves.svg?raw';
import wind from 'lucide-static/icons/wind.svg?raw';
import wrench from 'lucide-static/icons/wrench.svg?raw';
import x from 'lucide-static/icons/x.svg?raw';

const LUCIDE = {
  'alert-triangle': alertTriangle, 'triangle-alert': alertTriangle,
  'arrow-right': arrowRight, 'arrow-up-right': arrowUpRight,
  'badge-check': badgeCheck, 'building-2': building2, cable, calendar, check,
  'chevron-down': chevronDown, 'chevron-right': chevronRight,
  'clipboard-check': clipboardCheck, clock, 'cooking-pot': cookingPot, droplets,
  facebook, 'file-check': fileCheck, flame, 'flame-kindling': flameKindling, gauge,
  home, house: home, instagram, mail, 'map-pin': mapPin, 'message-circle': messageCircle,
  move, phone, pipette, power, receipt, 'search-check': searchCheck,
  'shield-check': shieldCheck, 'shopping-bag': shoppingBag, star, thermometer,
  'thermometer-snowflake': thermometerSnowflake, 'trending-up': trendingUp,
  'volume-2': volume2, 'volume-x': volumeX, waves, wind, wrench, x,
  // Marca do WhatsApp: preenchida, fora do conjunto lucide.
  whatsapp: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.92C21.95 6.45 17.5 2 12.04 2Zm0 18.15c-1.53 0-3.03-.41-4.34-1.19l-.31-.18-3.22.85.86-3.14-.2-.33a8.19 8.19 0 0 1-1.26-4.25c0-4.54 3.7-8.24 8.25-8.24 4.54 0 8.24 3.7 8.24 8.25 0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.7-.81-.23-.08-.4-.12-.56.13-.17.25-.65.81-.8.98-.14.16-.29.19-.54.06a6.72 6.72 0 0 1-1.98-1.22 7.4 7.4 0 0 1-1.37-1.7c-.14-.25-.02-.39.11-.51.11-.12.25-.29.37-.43.12-.15.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.65.31-.23.25-.86.85-.86 2.06 0 1.22.88 2.39 1 2.56.13.16 1.73 2.77 4.2 3.78 2.06.85 2.48.68 2.93.64.45-.04 1.45-.6 1.66-1.18.2-.58.2-1.07.14-1.18-.06-.1-.23-.16-.48-.28Z"/></svg>',
};

const { nome, tam = 20, largura = 1.75, cor } = Astro.props;

// O lucide-static vem com width/height 24 e stroke-width 2 fixos no arquivo.
const bruto = LUCIDE[nome] || LUCIDE['badge-check'];
const svg = bruto
  .replace(/\swidth="[^"]*"/, ' width="' + tam + '"')
  .replace(/\sheight="[^"]*"/, ' height="' + tam + '"')
  .replace(/\sstroke-width="[^"]*"/, ' stroke-width="' + largura + '"')
  .replace('<svg', '<svg aria-hidden="true" focusable="false"' + (cor ? ' style="color:' + cor + '"' : ''));
---
<Fragment set:html={svg} />

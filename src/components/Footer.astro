---
import Assinatura from './Assinatura.astro';
import Icone from './Icone.astro';
import { NEGOCIO, SERVICOS, SERVICOS_RODAPE, servicoUrl } from '../data/site.js';

const servicos = SERVICOS_RODAPE.map((s) => [s, SERVICOS[s]]);
const REDES = [
  { nome: 'Facebook', icone: 'facebook', href: 'https://www.facebook.com/people/Tec-Daniels-Solu%C3%A7%C3%B5es-em-Aquecedores/100088495374319/' },
  { nome: 'Instagram', icone: 'instagram', href: 'https://www.instagram.com/tecdaniels/' },
];
---
<footer class="pe">
<div class="env pe__grade">

<div class="pe__col">
<div class="pe__logo">
<img src="/assets/mascote-td-pequeno.webp" alt="" width="60" height="52" loading="lazy">
<Assinatura tom="claro" />
</div>
<p class="pe__sobre">Aquecedores a gás no Rio de Janeiro. Instalação, manutenção, venda e assistência técnica autorizada, com técnicos especializados.</p>
<p class="pe__tagline">{NEGOCIO.tagline}</p>
<a href={NEGOCIO.rinnai} target="_blank" rel="noopener" class="pe__rinnai">
<img src="/assets/selo-parceiro-rinnai.jpg" alt="Selo de Parceiro Credenciado Rinnai" width="96" height="96" loading="lazy">
<span class="pil" style="gap:2px;max-width:18ch">
<b>Parceiro Credenciado Rinnai</b>
<span>Confira no diretório oficial da Rinnai</span>
</span>
</a>
</div>

<div>
<p class="pe__rotulo">Principais serviços</p>
<div class="pe__servicos">
{servicos.map(([slug, nome]) => (<a href={servicoUrl(slug)}>{nome}</a>))}
</div>
<p class="pe__sobre" style="margin-top:var(--sp-4)"><a href="/#todos-os-servicos">Ver todos os serviços de aquecedor e gás</a></p>
</div>

<div class="pe__col">
<p class="pe__rotulo">Contato</p>
<a href={'tel:' + NEGOCIO.telefoneE164} class="pe__telefone">{NEGOCIO.telefone}</a>
<span class="pe__dado">{NEGOCIO.endereco.rua} · {NEGOCIO.endereco.cidade} — {NEGOCIO.endereco.estado}</span>
<span class="pe__dado"><Icone nome="clock" tam={15} />Seg–Sex 8h–18h · Sáb 8h–12h</span>
<div class="pil" style="gap:var(--sp-3);margin-top:var(--sp-4)">
<p class="pe__rotulo">Nossas redes sociais</p>
<div class="pe__redes">
{REDES.map((r) => (
  <a href={r.href} target="_blank" rel="noopener" aria-label={r.nome} title={r.nome} class="pe__tile"><Icone nome={r.icone} tam={24} /></a>
))}
<button type="button" class="pe__tile js-whatsapp-cta" data-whatsapp-source="rodape" aria-label="WhatsApp" title="WhatsApp" style="border:0;cursor:pointer">
<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.13-.42-2.15-1.33-.8-.71-1.34-1.6-1.5-1.9-.15-.3-.01-.46.13-.61.16-.16.35-.42.52-.62.14-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.68-1.62-.93-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.03 1-1.03 2.44 0 1.44 1.05 2.83 1.2 3.03.15.2 2.05 3.14 4.97 4.28 2.43.94 2.92.75 3.44.7.53-.05 1.71-.7 1.95-1.37.24-.68.24-1.25.17-1.37-.07-.12-.27-.2-.57-.35z"/><path d="M12.04 2C6.6 2 2.18 6.4 2.18 11.82c0 1.73.46 3.42 1.32 4.9L2 22l5.42-1.42a9.9 9.9 0 0 0 4.62 1.17h.01c5.43 0 9.85-4.4 9.85-9.82C21.9 6.4 17.47 2 12.04 2zm0 17.98h-.01a8.2 8.2 0 0 1-4.16-1.14l-.3-.18-3.1.81.83-3.02-.19-.31a8.13 8.13 0 0 1-1.25-4.32c0-4.5 3.68-8.16 8.19-8.16 2.19 0 4.24.85 5.79 2.39a8.1 8.1 0 0 1 2.4 5.78c0 4.5-3.68 8.16-8.2 8.16z"/></svg>
</button>
</div>
</div>
</div>

</div>

<div class="pe__base">
<div class="env">
<a href="/">Aquecedores a gás no Rio de Janeiro</a> · CNPJ {NEGOCIO.cnpj} · <a href="/politica-de-privacidade/">Política de privacidade</a> · © 2026 TecDaniel’s · Aquecedores a Gás. Todos os direitos reservados.
</div>
</div>
</footer>

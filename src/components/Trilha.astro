---
/** Breadcrumb — espelha Breadcrumb.jsx: separador chevron-right, último item
 *  em destaque. A mesma lista alimenta o nó BreadcrumbList no Base.astro. */
import Icone from './Icone.astro';
const { itens = [], claro = false } = Astro.props;
---
<nav class:list={['trilha', claro && 'trilha--claro']} aria-label="Você está aqui">
{claro ? (
  <ol>
  {itens.map((t, i) => (
    <li>
    {i > 0 && <span class="trilha__sep"><Icone nome="chevron-right" tam={13} /></span>}
    {i === itens.length - 1 || !t.href ? <span aria-current="page">{t.nome}</span> : <a href={t.href}>{t.nome}</a>}
    </li>
  ))}
  </ol>
) : (
  <div class="env">
  <ol>
  {itens.map((t, i) => (
    <li>
    {i > 0 && <span class="trilha__sep"><Icone nome="chevron-right" tam={13} /></span>}
    {i === itens.length - 1 || !t.href ? <span aria-current="page">{t.nome}</span> : <a href={t.href}>{t.nome}</a>}
    </li>
  ))}
  </ol>
  </div>
)}
</nav>

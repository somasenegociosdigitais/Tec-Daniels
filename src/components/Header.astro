---
import Assinatura from './Assinatura.astro';
import Icone from './Icone.astro';
import { NEGOCIO, MENU } from '../data/site.js';
const atual = Astro.url.pathname;
const tel = 'tel:' + NEGOCIO.telefoneE164;
const zap = 'https://wa.me/' + NEGOCIO.whatsapp;
---
<header class="cab">

<div class="cab__faixa">
<div class="env">
<span class="cab__faixa-quem"><Icone nome="flame" tam={14} /><span class="so-largo">{NEGOCIO.marca} &mdash; assist&ecirc;ncia t&eacute;cnica em aquecedores a g&aacute;s no Rio de Janeiro</span><span class="so-estreito">Aquecedores a g&aacute;s no Rio</span></span>
<span class="cab__faixa-prazo"><Icone nome="clock" tam={14} /><span class="so-largo">Visita t&eacute;cnica em at&eacute; 24 horas</span><span class="so-estreito">Visita em at&eacute; 24h</span></span>
<span class="cab__faixa-dir">
<a href={tel} class="cab__faixa-contato"><Icone nome="phone" tam={15} /><b>Telefone:</b>{NEGOCIO.telefone}</a>
<a href={zap} class="cab__faixa-contato js-whatsapp-cta" data-whatsapp-source="faixa-topo"><Icone nome="whatsapp" tam={16} /><b>WhatsApp:</b>{NEGOCIO.telefone}</a>
</span>
</div>
</div>

<div class="env cab__linha">
<a href="/" class="cab__logo" aria-label={NEGOCIO.marca + ' — início'}>
<img src="/assets/mascote-td-pequeno.webp" alt="" width="53" height="46" fetchpriority="high">
<Assinatura />
</a>
<nav class="cab__nav" aria-label="Navegação principal">
{MENU.map((m) => (
  <a href={m.href} class:list={[m.href === '/' && 'cab__nav-inicio']} aria-current={atual === m.href ? 'page' : undefined}>
  {m.curto ? (<><span class="so-largo">{m.label}</span><span class="so-estreito">{m.curto}</span></>) : m.label}
  </a>
))}
</nav>
<div class="cab__acoes">
<a href={tel} class="cab__tel"><Icone nome="phone" tam={17} />{NEGOCIO.telefone}</a>
<button type="button" class="btn btn--zap btn--sm js-whatsapp-cta" data-whatsapp-source="cabecalho">
<Icone nome="message-circle" tam={15} /><span class="so-largo">Pe&ccedil;a seu or&ccedil;amento</span><span class="so-estreito">Or&ccedil;amento</span>
</button>
</div>
</div>

</header>

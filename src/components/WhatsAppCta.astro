---
/** Botão flutuante + modal de contato. Todo elemento com a classe
 *  js-whatsapp-cta abre o modal; o envio empurra o evento whatsapp_lead
 *  para o dataLayer (GTM) e só então abre a conversa.
 *  Este é o único JavaScript do site. */
import Icone from './Icone.astro';
import { NEGOCIO } from '../data/site.js';
const { privacidadeHref = '/politica-de-privacidade/' } = Astro.props;
---
<button type="button" class="zap-fab js-whatsapp-cta" data-whatsapp-source="botao-flutuante" aria-label="Falar no WhatsApp">
<svg viewBox="0 0 24 24" width="34" height="34" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.13-.42-2.15-1.33-.8-.71-1.34-1.6-1.5-1.9-.15-.3-.01-.46.13-.61.16-.16.35-.42.52-.62.14-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.68-1.62-.93-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.03 1-1.03 2.44 0 1.44 1.05 2.83 1.2 3.03.15.2 2.05 3.14 4.97 4.28 2.43.94 2.92.75 3.44.7.53-.05 1.71-.7 1.95-1.37.24-.68.24-1.25.17-1.37-.07-.12-.27-.2-.57-.35z"/><path d="M12.04 2C6.6 2 2.18 6.4 2.18 11.82c0 1.73.46 3.42 1.32 4.9L2 22l5.42-1.42a9.9 9.9 0 0 0 4.62 1.17h.01c5.43 0 9.85-4.4 9.85-9.82C21.9 6.4 17.47 2 12.04 2zm0 17.98h-.01a8.2 8.2 0 0 1-4.16-1.14l-.3-.18-3.1.81.83-3.02-.19-.31a8.13 8.13 0 0 1-1.25-4.32c0-4.5 3.68-8.16 8.19-8.16 2.19 0 4.24.85 5.79 2.39a8.1 8.1 0 0 1 2.4 5.78c0 4.5-3.68 8.16-8.2 8.16z"/></svg>
</button>

<div class="zap-modal" id="zap-modal" role="dialog" aria-modal="true" aria-labelledby="zap-titulo" hidden>
<form class="zap-form" id="zap-form" novalidate>
<button type="button" class="zap-form__fechar" id="zap-fechar" aria-label="Fechar"><Icone nome="x" tam={20} /></button>
<div class="pil" style="gap:var(--sp-2)">
<h2 class="t-h3" id="zap-titulo">Fale com um técnico</h2>
<p class="t-sm">Deixe seu nome e telefone antes de seguir para o WhatsApp.</p>
</div>
<label class="zap-campo">
<span>Nome</span>
<input type="text" name="nome" placeholder="Seu nome" autocomplete="name" required>
</label>
<label class="zap-campo">
<span>Telefone</span>
<input type="tel" name="telefone" placeholder="Telefone / WhatsApp" inputmode="tel" autocomplete="tel" required>
</label>
<label class="zap-aceite">
<input type="checkbox" name="aceite" required>
<span>Li e concordo com a <a href={privacidadeHref}>Política de Privacidade</a>.</span>
</label>
<p class="zap-erro" id="zap-erro" hidden>Preencha nome, telefone e aceite a política para continuar.</p>
<button type="submit" class="btn btn--zap btn--lg" style="width:100%">
<Icone nome="message-circle" tam={19} />Continuar para o WhatsApp
</button>
</form>
</div>

<script is:inline define:vars={{ whatsapp: NEGOCIO.whatsapp }}>
(() => {
  const modal = document.getElementById('zap-modal');
  const form = document.getElementById('zap-form');
  const erro = document.getElementById('zap-erro');
  let origem = '';

  const abrir = (fonte) => {
    origem = fonte || '';
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'whatsapp_form_abriu', cta_source: origem || 'indefinido' });
    form.querySelector('input[name=nome]').focus();
  };
  const fechar = () => {
    modal.hidden = true;
    erro.hidden = true;
    document.body.style.overflow = '';
  };

  document.addEventListener('click', (e) => {
    const alvo = e.target.closest('.js-whatsapp-cta');
    if (!alvo) return;
    e.preventDefault();
    abrir(alvo.dataset.whatsappSource || alvo.textContent.trim());
  });

  document.getElementById('zap-fechar').addEventListener('click', fechar);
  modal.addEventListener('click', (e) => { if (e.target === modal) fechar(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) fechar(); });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const nome = form.nome.value.trim();
    const tel = form.telefone.value.trim();
    const ok = nome.length > 1 && tel.replace(/\D/g, '').length >= 10 && form.aceite.checked;
    erro.hidden = ok;
    if (!ok) return;

    const texto = 'Gostaria de orçamento para visita técnica. Nome: ' + nome + '. Telefone: ' + tel + (origem ? '. Origem: ' + origem : '');
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'whatsapp_lead', lead_name: nome, lead_phone: tel, cta_source: origem || 'indefinido' });
    window.open('https://api.whatsapp.com/send/?phone=' + whatsapp + '&text=' + encodeURIComponent(texto) + '&type=phone_number&app_absent=0', '_blank', 'noopener');
    form.reset();
    fechar();
  });
})();
</script>

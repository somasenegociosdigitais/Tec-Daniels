---
/**
 * Formulário de contato completo (nome, telefone, bairro, serviço, marca, detalhes).
 * Fluxo igual ao do botão WhatsApp (WhatsAppCta.astro):
 *   1. gera o código S-XXXX;
 *   2. grava o contato na planilha "Contatos do site" (fica salvo mesmo se o cliente não enviar);
 *   3. empurra `form_lead` para o dataLayer, só com lead_code, lead_service e cta_source
 *      (nome, telefone e bairro NUNCA vão para o Google);
 *   4. abre o WhatsApp com a mensagem pronta e o código no fim;
 *   5. troca o formulário por um aviso "falta 1 passo: toque em Enviar", com botão para
 *      abrir o WhatsApp de novo (se o app não abriu ou o cliente voltou sem enviar).
 *
 * Uso:
 *   <FormContato />
 *   <FormContato servicoPadrao="Conserto de aquecedor" />
 *   <FormContato marcaPadrao="Rinnai" titulo="Fale com a assistência Rinnai" />
 * servicoPadrao/marcaPadrao precisam ter o texto exato de uma opção das listas abaixo.
 */
import { NEGOCIO } from '../data/site.js';
interface Props { titulo?: string; servicoPadrao?: string; marcaPadrao?: string; privacidadeHref?: string }
const {
  titulo = 'Peça seu orçamento',
  servicoPadrao = '',
  marcaPadrao = '',
  privacidadeHref = '/politica-de-privacidade/',
} = Astro.props;
const servicos = [
  'Conserto de aquecedor', 'Manutenção / revisão anual', 'Instalação de aquecedor',
  'Compra de aquecedor novo', 'Gasista / rede de gás', 'Conversão ou instalação de fogão',
  'Teste de estanqueidade / vazamento', 'Pressurizador de água', 'Outro',
];
const marcas = ['Rinnai', 'Lorenzetti', 'Komeco', 'Rheem', 'Bosch', 'Orbis', 'Outra', 'Não sei'];
const PLANILHA = 'https://script.google.com/macros/s/AKfycbzpfUNZ1pY4HU4TFRTCIVpBc6nVGVv9dmZAUAf2aiUNpquri7ox4KdSn2CSQYAByjddjg/exec';
---
<form class="form-ct" data-whatsapp={NEGOCIO.whatsapp} data-planilha={PLANILHA} novalidate>
<h2 class="form-ct__titulo">{titulo}</h2>
<p class="form-ct__sub">O técnico recebe o seu caso e responde pelo WhatsApp.</p>
<div class="form-ct__grid">
<label class="form-ct__campo"><span>Seu nome *</span><input name="nome" type="text" autocomplete="name" required maxlength="60"></label>
<label class="form-ct__campo"><span>Telefone / WhatsApp *</span><input name="telefone" type="tel" inputmode="tel" autocomplete="tel" required maxlength="16" placeholder="DDD opcional"></label>
<label class="form-ct__campo"><span>Bairro *</span><input name="bairro" type="text" autocomplete="address-level3" required maxlength="60" placeholder="Ex.: Taquara, Freguesia, Barra"></label>
<label class="form-ct__campo"><span>O que você precisa? *</span><select name="servico" required><option value="" disabled selected={!servicoPadrao}>Escolha uma opção</option>{servicos.map((s) => <option value={s} selected={s === servicoPadrao}>{s}</option>)}</select></label>
<label class="form-ct__campo"><span>Marca do aparelho</span><select name="marca"><option value="" selected={!marcaPadrao}>Escolha (opcional)</option>{marcas.map((m) => <option value={m} selected={m === marcaPadrao}>{m}</option>)}</select></label>
<label class="form-ct__campo form-ct__campo--largo"><span>Conte rapidamente o que está acontecendo</span><textarea name="detalhes" rows="3" maxlength="500" placeholder="Ex.: o aquecedor liga, mas a água não esquenta"></textarea></label>
</div>
<label class="form-ct__aceite"><input type="checkbox" name="aceite" required><span>Li e concordo com a <a href={privacidadeHref}>Política de Privacidade</a>.</span></label>
<p class="form-ct__erro" role="alert" hidden></p>
<button type="submit" class="form-ct__botao">Enviar pelo WhatsApp</button>
<p class="form-ct__nota">Prefere ligar? <a href={'tel:' + NEGOCIO.telefoneE164}>{NEGOCIO.telefone}</a></p>
</form>
<div class="form-ct form-ct--ok" role="status" hidden>
<h2 class="form-ct__titulo">Falta só 1 passo</h2>
<p class="form-ct__sub">O WhatsApp abriu com a sua mensagem pronta. <strong>Toque em Enviar</strong> para o técnico receber o seu pedido.</p>
<p class="form-ct__codigo">Seu código: <strong class="js-ct-codigo"></strong></p>
<a class="form-ct__botao js-ct-reabrir" href="#">Abrir o WhatsApp de novo</a>
<p class="form-ct__nota">Se o WhatsApp não abrir, ligue: <a href={'tel:' + NEGOCIO.telefoneE164}>{NEGOCIO.telefone}</a>. Já recebemos seus dados e retornamos o contato.</p>
</div>

<style>
.form-ct{--ct-azul:#123C7A;--ct-verde:#0f7a3d;--ct-borda:#c9d3e3;background:#fff;border:1px solid var(--ct-borda);border-radius:16px;padding:clamp(20px,4vw,32px);max-width:720px;margin-inline:auto;color:#1c2533}
.form-ct__titulo{margin:0 0 6px;color:var(--ct-azul);font-size:clamp(1.3rem,3vw,1.6rem)}
.form-ct__sub{margin:0 0 20px;color:#4a5568}
.form-ct__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px 16px}
.form-ct__campo{display:flex;flex-direction:column;gap:6px;font-weight:600;font-size:.95rem}
.form-ct__campo--largo{grid-column:1/-1}
.form-ct__campo input,.form-ct__campo select,.form-ct__campo textarea{font:inherit;font-weight:400;font-size:16px;box-sizing:border-box;padding:12px 14px;min-height:48px;width:100%;border:1px solid var(--ct-borda);border-radius:10px;background:#fff;color:inherit}
.form-ct__campo textarea{resize:vertical}
.form-ct :focus-visible{outline:3px solid #ffc425;outline-offset:1px}
.form-ct [aria-invalid='true']{border-color:#b42318}
.form-ct__aceite{display:flex;gap:10px;align-items:flex-start;margin-top:16px;font-size:.95rem}
.form-ct__aceite input{width:22px;height:22px;flex:none;margin-top:1px}
.form-ct__aceite a{color:var(--ct-azul)}
.form-ct__erro{color:#b42318;font-weight:600;margin:14px 0 0}
.form-ct__botao{margin-top:18px;width:100%;min-height:54px;background:var(--ct-verde);color:#fff;border:0;border-radius:12px;font:inherit;font-size:1.1rem;font-weight:700;cursor:pointer}
.form-ct__botao:hover{filter:brightness(1.08)}
.form-ct--ok{text-align:center}
a.form-ct__botao{display:flex;align-items:center;justify-content:center;text-decoration:none}
.form-ct__codigo{font-size:1.15rem;margin:0 0 4px}
.form-ct__nota{margin:12px 0 0;font-size:.95rem;color:#4a5568;text-align:center}
.form-ct__nota a{color:#123C7A;font-weight:700}
</style>

<script is:inline>
(() => {
  const gerarCodigo = () => {
    const c = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    let r = 'S-';
    for (let i = 0; i < 4; i++) r += c[Math.floor(Math.random() * c.length)];
    return r;
  };
  const gravar = (url, dados) => {
    const corpo = JSON.stringify(Object.assign({ k: 'td' }, dados));
    try { if (navigator.sendBeacon && navigator.sendBeacon(url, new Blob([corpo], { type: 'text/plain' }))) return; } catch (_) {}
    fetch(url, { method: 'POST', mode: 'no-cors', keepalive: true, headers: { 'Content-Type': 'text/plain' }, body: corpo }).catch(() => {});
  };
  document.querySelectorAll('form.form-ct').forEach((form) => {
    const erro = form.querySelector('.form-ct__erro');
    form.telefone.addEventListener('input', () => {
      let d = form.telefone.value.replace(/\D/g, '');
      if (d.length >= 12 && d.startsWith('55')) d = d.slice(2);
      d = d.slice(0, 11);
      form.telefone.value = d.length >= 10 ? '(' + d.slice(0, 2) + ') ' + d.slice(2, d.length - 4) + '-' + d.slice(-4) : d;
    });
    form.addEventListener('input', (e) => {
      if (e.target.getAttribute('aria-invalid') === 'true') e.target.setAttribute('aria-invalid', 'false');
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const v = (k) => String(form[k].value || '').trim();
      let d = v('telefone').replace(/\D/g, '');
      if (d.length >= 12 && d.startsWith('55')) d = d.slice(2);
      if (d.length === 8 || d.length === 9) d = '21' + d;
      const tel = d.length >= 10 ? '(' + d.slice(0, 2) + ') ' + d.slice(2, d.length - 4) + '-' + d.slice(-4) : '';
      const checar = [
        [v('nome').length >= 2, form.nome, 'Escreva seu nome para o técnico saber com quem falar.'],
        [!!tel, form.telefone, 'Informe o telefone completo. O DDD é opcional: sem ele, usamos o 21.'],
        [!!v('bairro'), form.bairro, 'Informe o bairro.'],
        [!!v('servico'), form.servico, 'Escolha o que você precisa.'],
        [form.aceite.checked, form.aceite, 'Marque a caixinha da Política de Privacidade para continuar.'],
      ];
      const falha = checar.find((c) => !c[0]);
      if (falha) {
        falha[1].setAttribute('aria-invalid', 'true');
        erro.textContent = falha[2];
        erro.hidden = false;
        falha[1].focus();
        return;
      }
      erro.hidden = true;
      const codigo = gerarCodigo();
      const servico = v('servico'), marca = v('marca'), detalhes = v('detalhes');
      gravar(form.dataset.planilha, {
        tipo: 'Formulário', codigo, nome: v('nome'), telefone: tel, servico,
        pagina: location.pathname, origem: 'formulario', bairro: v('bairro'), marca, detalhes,
      });
      const texto = [
        "Olá! Vim pelo site da TecDaniel's.",
        '*Nome:* ' + v('nome'),
        '*Bairro:* ' + v('bairro'),
        '*Serviço:* ' + servico,
        marca ? '*Marca:* ' + marca : '',
        detalhes ? '*Detalhes:* ' + detalhes : '',
        'Código: ' + codigo,
      ].filter(Boolean).join('\n');
      const url = 'https://api.whatsapp.com/send/?phone=' + form.dataset.whatsapp + '&text=' + encodeURIComponent(texto) + '&type=phone_number&app_absent=0';
      const ok = form.nextElementSibling;
      if (ok && ok.classList.contains('form-ct--ok')) {
        ok.querySelector('.js-ct-codigo').textContent = codigo;
        ok.querySelector('.js-ct-reabrir').href = url;
        form.hidden = true;
        ok.hidden = false;
      }
      let foi = false;
      const abrir = () => { if (!foi) { foi = true; window.location.href = url; } };
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'form_lead', lead_code: codigo, lead_service: servico, cta_source: 'formulario', eventCallback: abrir, eventTimeout: 1200 });
      setTimeout(abrir, 1200);
    });
  });
})();
</script>
